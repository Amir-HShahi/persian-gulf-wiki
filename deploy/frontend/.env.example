# Optional overrides for deploy/frontend/docker-compose.yml. Copy to .env next to it.
# Everything else is fixed local-dev values inside the compose file.

# Pin the API image. Default is :staging (tracks master); use a version tag (e.g. 0.4.0) once releases exist.
# PGW_IMAGE=ghcr.io/amir-hshahi/persian-gulf-wiki-core:staging

# Where your frontend dev server runs. Drives CORS on the API and MinIO and the links in emails.
# FRONTEND_BASE_URL=http://localhost:3000
# FRONTEND_ORIGINS=http://localhost:3000
