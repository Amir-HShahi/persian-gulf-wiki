# Spring profile. "dev" routes outgoing mail to the Mailpit container instead of a
# real SMTP server, and turns off SMTP auth/STARTTLS (Mailpit has neither).
SPRING_PROFILES_ACTIVE=dev

# Compose profile (not the Spring one). Staging only: enables mailpit in
# docker-compose.deploy.yml. No-op locally.
# COMPOSE_PROFILES=staging

DB_HOST=localhost
DB_PORT=5432
DB_NAME=core
DB_USERNAME=changeme
DB_PASSWORD=changeme

JWT_SECRET=changeme-32-bytes-minimum

# Real SMTP credentials — only needed outside the "dev" profile. With
# SPRING_PROFILES_ACTIVE=dev, application-dev.yaml points mail at the Mailpit
# container (localhost:1025, UI at http://localhost:8025) and MAIL_USERNAME /
# MAIL_PASSWORD are ignored entirely.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme
MAIL_FROM=noreply@example.com

FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# Registrable parent domain shared by the API and frontend hosts, e.g.
# "persiangulfwiki.ravensandrunse.me" in prod (api.persiangulfwiki.ravensandrunse.me +
# persiangulfwiki.ravensandrunse.me). Use "localhost" for local dev.
COOKIE_DOMAIN=localhost
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme

# --- dev-profile fixture endpoints (/api/dev/**) ---
# How long a machine-minted fixture survives before its hourly sweeper reclaims it.
# Only read under SPRING_PROFILES_ACTIVE=dev; the endpoints and sweepers do not exist in
# any other profile. Defaults shown — omit them entirely and application-dev.yaml uses 6.
DEV_TEST_USER_TTL_HOURS=6
DEV_TEST_SUBJECT_TTL_HOURS=6
DEV_TEST_SOURCE_TTL_HOURS=6
DEV_TEST_ARTICLE_TTL_HOURS=6

# --- submission-pipeline (Go worker) ---

# The worker reads the DB_* variables above — it connects to the same Postgres
# as core and claims from the jobs table. Nothing extra to set here.
# DB_MAX_CONNS=8

# Credentials for the MinIO server itself. On the server these are the only
# storage values that need setting: docker-compose.deploy.yml points the worker
# at the in-network MinIO and reuses these as its access key and secret.
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
# MinIO enforces an 8 character minimum on the root password.

MINIO_RAW_BUCKET=submissions-raw
MINIO_DERIVED_BUCKET=submissions-derived

# Local development only. docker-compose.yml publishes MinIO on 9000 with the
# dev credentials below, so a worker run outside Compose reaches it here. In
# deployment these three are set by docker-compose.deploy.yml and ignored here.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_USE_SSL=false

# Optional — defaults shown.
# WORKER_CONCURRENCY=4
# WORKER_MAX_FILE_BYTES=268435456
# WORKER_JOB_TIMEOUT=5m
#
# NOTIFY wakes workers immediately; this poll is the safety net for
# notifications missed while a worker was reconnecting.
# WORKER_POLL_INTERVAL=10s
#
# A running job extends its lock every HEARTBEAT_INTERVAL until LOCK_DURATION
# passes without one, at which point another worker may reclaim it. The
# heartbeat must be at most half the lock duration, and the job timeout must
# not exceed it — the worker refuses to start otherwise.
# WORKER_HEARTBEAT_INTERVAL=1m
# WORKER_LOCK_DURATION=10m
#
# After MAX_ATTEMPTS the job is dead-lettered (status=failed) for a human.
# WORKER_MAX_ATTEMPTS=5
# WORKER_RETRY_BASE_DELAY=30s

LOG_LEVEL=info