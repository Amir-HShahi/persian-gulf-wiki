# Spring profile. "dev" routes outgoing mail to the Mailpit container instead of a
# real SMTP server, and turns off SMTP auth/STARTTLS (Mailpit has neither).
SPRING_PROFILES_ACTIVE=dev

# Compose profile (not the Spring one). Staging only: enables mailpit in
# docker-compose.deploy.yml. No-op locally.
# COMPOSE_PROFILES=staging

DB_HOST=localhost
DB_PORT=5432
DB_NAME=core
DB_USERNAME=changeme
DB_PASSWORD=changeme

JWT_SECRET=changeme-32-bytes-minimum

# Real SMTP credentials — only needed outside the "dev" profile. With
# SPRING_PROFILES_ACTIVE=dev, application-dev.yaml points mail at the Mailpit
# container (localhost:1025, UI at http://localhost:8025) and MAIL_USERNAME /
# MAIL_PASSWORD are ignored entirely.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme
MAIL_FROM=noreply@example.com

FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# Registrable parent domain shared by the API and frontend hosts, e.g.
# "persiangulfwiki.ravensandrunse.me" in prod (api.persiangulfwiki.ravensandrunse.me +
# persiangulfwiki.ravensandrunse.me). Use "localhost" for local dev.
COOKIE_DOMAIN=localhost
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme

# --- dev-profile fixture endpoints (/api/dev/**) ---
# How long a machine-minted fixture survives before its hourly sweeper reclaims it.
# Only read under SPRING_PROFILES_ACTIVE=dev; the endpoints and sweepers do not exist in
# any other profile. Defaults shown — omit them entirely and application-dev.yaml uses 6.
DEV_TEST_USER_TTL_HOURS=6
DEV_TEST_SUBJECT_TTL_HOURS=6
DEV_TEST_SOURCE_TTL_HOURS=6
DEV_TEST_ARTICLE_TTL_HOURS=6
DEV_TEST_MODERATION_TTL_HOURS=6
DEV_TEST_MEDIA_TTL_HOURS=6

# --- object storage for the article gallery (core) ---
# Plain S3: the self-hosted MinIO build now (docker-compose*.yml), AWS S3 later -- only these
# values change. Under SPRING_PROFILES_ACTIVE=dev every one defaults to the local compose
# MinIO (see application-dev.yaml), so they can be left commented out locally.
#
# STORAGE_ENDPOINT is where the app reaches the store; STORAGE_PUBLIC_ENDPOINT is where the
# browser does. Presigned upload/download URLs are signed for the public one's host, so it must
# be exactly what the browser sees (http://localhost:9000 locally, the tunnel hostname on
# staging). docker-compose.deploy.yml hard-wires STORAGE_ENDPOINT to http://minio:9000.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
# Also the MinIO root user/password the compose files start MinIO with (password: 8+ chars).
STORAGE_ACCESS_KEY=changeme
STORAGE_SECRET_KEY=changeme-8-chars-minimum
# The same two buckets the Go worker's MINIO_RAW_BUCKET / MINIO_DERIVED_BUCKET below name --
# core writes originals to the first and the worker writes variants to the second, so the
# two pairs must stay equal.
STORAGE_STAGING_BUCKET=submissions-raw
STORAGE_MEDIA_BUCKET=submissions-derived
# Where approved variants are publicly served from (the media bucket's public/ prefix, or a
# CDN in front of it).
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/submissions-derived/public
# true for MinIO, false for AWS S3.
STORAGE_PATH_STYLE=true


# --- submission-pipeline (Go worker) ---

REDIS_ADDR=localhost:6379
# Empty locally: the compose Redis runs without auth.
REDIS_PASSWORD=
# Both streams are shared with core: it writes jobs to the first and reads results from the
# second (docs/MEDIA_PIPELINE.md). REDIS_CONSUMER_GROUP is the worker's group on the job stream.
REDIS_JOB_STREAM=submissions
REDIS_RESULT_STREAM=submission-results
REDIS_CONSUMER_GROUP=pipeline

# The Go worker still reads its own MINIO_* names (not STORAGE_* above). Point them at the
# same store and buckets.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_USE_SSL=false
MINIO_RAW_BUCKET=submissions-raw
MINIO_DERIVED_BUCKET=submissions-derived

# Optional — defaults shown.
# WORKER_CONCURRENCY=4
# WORKER_MAX_FILE_BYTES=268435456
# WORKER_JOB_TIMEOUT=5m
LOG_LEVEL=info